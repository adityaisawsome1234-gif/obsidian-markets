generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  image         String?
  provider      String?
  providerId    String?
  investorType  InvestorType @default(CASUAL)
  experience    ExperienceLevel @default(BEGINNER)
  timezone      String    @default("America/New_York")
  plan          Plan      @default(FREE)
  stripeId      String?   @unique
  planExpiresAt DateTime?
  watchlists    Watchlist[]
  portfolios    Portfolio[]
  alerts        Alert[]
  aiChats       AiChatSession[]
  savedScreens  SavedScreen[]
  preferences   UserPreferences?
  alphaTrades          AlphaTrade[]
  alphaRecommendationRuns AlphaRecommendationRun[]
  alphaPatternStats    AlphaPatternStats[]
  alphaEdgeSnapshots   AlphaEdgeSnapshot[]
  alphaWeeklyReports   AlphaWeeklyReport[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
}

enum InvestorType {
  DAY_TRADER
  SWING_TRADER
  OPTIONS_TRADER
  LONG_TERM
  CASUAL
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PROFESSIONAL
}

enum Plan {
  FREE
  STARTER
  PRO
  ELITE
}

model UserPreferences {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  defaultChartType   String   @default("candle")
  defaultTimeframe   String   @default("1D")
  dashboardLayout    Json?
  favoriteIndicators String[] @default([])
  newsCategories     String[] @default([])
  notifyEmail        Boolean  @default(true)
  notifyPush         Boolean  @default(true)
  notifySms          Boolean  @default(false)
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  tickers   String[]
  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Portfolio {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id])
  name        String
  isConnected Boolean             @default(false)
  plaidItemId String?
  holdings    Holding[]
  snapshots   PortfolioSnapshot[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
}

model Holding {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id])
  ticker      String
  shares      Float
  avgCost     Float
  assetType   AssetType @default(STOCK)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([portfolioId])
  @@index([ticker])
}

enum AssetType {
  STOCK
  ETF
  OPTION
  CRYPTO
  BOND
  CASH
}

model PortfolioSnapshot {
  id           String   @id @default(cuid())
  portfolioId  String
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id])
  totalValue   Float
  dayChange    Float
  dayChangePct Float
  snapshotDate DateTime

  @@index([portfolioId, snapshotDate])
}

model Alert {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  ticker        String?
  alertType     AlertType
  condition     Json
  isActive      Boolean   @default(true)
  lastTriggered DateTime?
  channels      String[]  @default(["in_app"])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, isActive])
  @@index([ticker])
}

enum AlertType {
  PRICE_ABOVE
  PRICE_BELOW
  PRICE_CHANGE_PCT
  VOLUME_SPIKE
  OPTIONS_FLOW
  EARNINGS_DATE
  SEC_FILING
  CUSTOM_SCREEN
}

model AiChatSession {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  title     String?
  messages  AiMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model AiMessage {
  id        String        @id @default(cuid())
  sessionId String
  session   AiChatSession @relation(fields: [sessionId], references: [id])
  role      String
  content   String
  model     String?
  tokens    Int?
  createdAt DateTime      @default(now())

  @@index([sessionId])
}

model SavedScreen {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  name      String
  type      String
  filters   Json
  sortBy    String?
  sortDir   String?  @default("desc")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── SEC Filing Proprietary Data Pipeline ───

model SecFilingExtract {
  id                 Int      @id @default(autoincrement())
  accessionNumber    String   @unique @map("accession_number")
  filingType         String   @map("filing_type")
  company            String
  ticker             String
  cik                String?
  filedDate          DateTime @map("filed_date") @db.Date
  filingUrl          String?  @map("filing_url")
  documentUrl        String?  @map("document_url")
  rawTextHash        String?  @map("raw_text_hash")
  rawTextLength      Int      @default(0) @map("raw_text_length")

  // Structured extraction (JSON)
  materialEvents     Json     @default("[]") @map("material_events")
  financialMetrics   Json     @default("[]") @map("financial_metrics")
  insiderTransactions Json    @default("[]") @map("insider_transactions")
  riskFactorsNew     Json     @default("[]") @map("risk_factors_new")
  keyQuotes          Json     @default("[]") @map("key_quotes")

  // Extraction metadata
  extractionModel    String?  @map("extraction_model")
  extractionTokens   Int      @default(0) @map("extraction_tokens")
  extractionCostCents Float   @default(0) @map("extraction_cost_cents")

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([ticker])
  @@index([filedDate(sort: Desc)])
  @@index([ticker, filingType])
  @@index([filingType, filedDate(sort: Desc)])
  @@map("sec_filing_extracts")
}

model SecFilingChange {
  id                 Int      @id @default(autoincrement())
  ticker             String
  changeType         String   @map("change_type")
  description        String
  severity           String
  currentFilingDate  DateTime @map("current_filing_date") @db.Date
  priorFilingDate    DateTime @map("prior_filing_date") @db.Date
  currentAccession   String   @map("current_accession")
  priorAccession     String   @map("prior_accession")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([ticker])
  @@index([currentFilingDate(sort: Desc)])
  @@index([severity, currentFilingDate(sort: Desc)])
  @@map("sec_filing_changes")
}

model SecIngestionLog {
  id              Int       @id @default(autoincrement())
  runStartedAt    DateTime  @map("run_started_at")
  runFinishedAt   DateTime? @map("run_finished_at")
  filingsFound    Int       @default(0) @map("filings_found")
  filingsNew      Int       @default(0) @map("filings_new")
  filingsAnalyzed Int       @default(0) @map("filings_analyzed")
  changesDetected Int       @default(0) @map("changes_detected")
  totalCostCents  Float     @default(0) @map("total_cost_cents")
  status          String    @default("running")
  errorMessage    String?   @map("error_message")

  @@map("sec_ingestion_log")
}

// ─── Personal Alpha Engine ───

model AlphaTrade {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id])
  portfolioId       String?  @map("portfolio_id")
  symbol            String
  assetType         AssetType @default(STOCK) @map("asset_type")
  side              String   // "long" | "short"
  quantity          Float
  entryPrice        Float    @map("entry_price")
  exitPrice         Float?   @map("exit_price")
  openedAt          DateTime @map("opened_at")
  closedAt          DateTime? @map("closed_at")
  holdingPeriodDays Int?     @map("holding_period_days")
  pnlAbsolute       Float?   @map("pnl_absolute")
  pnlPercent        Float?   @map("pnl_percent")
  status            String   @default("open") // "open" | "closed"
  strategyTag       String   @map("strategy_tag")
  sector            String?
  marketCapBucket   String?  @map("market_cap_bucket")
  source            String   @default("manual") // "manual" | "imported" | "recommended"
  recommendationId  String?  @map("recommendation_id")
  notes             String?
  tags              String[] @default([])
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([userId, status])
  @@index([userId, strategyTag])
  @@index([userId, sector])
  @@index([userId, closedAt(sort: Desc)])
  @@index([symbol])
  @@map("alpha_trades")
}

model AlphaMarketSignal {
  id              String   @id @default(cuid())
  symbol          String
  signalType      String   @map("signal_type")
  signalTimestamp DateTime @map("signal_timestamp")
  signalStrength  Float    @map("signal_strength")
  rawPayload      Json     @default("{}") @map("raw_payload")
  derivedTags     String[] @default([]) @map("derived_tags")
  sector          String?
  marketContext   String?  @map("market_context")
  confidenceBase  Float    @default(0.5) @map("confidence_base")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([symbol, signalType])
  @@index([signalTimestamp(sort: Desc)])
  @@index([symbol, signalTimestamp(sort: Desc)])
  @@map("alpha_market_signals")
}

model AlphaRecommendationRun {
  id                       String   @id @default(cuid())
  userId                   String   @map("user_id")
  user                     User     @relation(fields: [userId], references: [id])
  triggeredAt              DateTime @map("triggered_at")
  triggerType              String   @default("manual") @map("trigger_type")
  symbolsEvaluated         Int      @default(0) @map("symbols_evaluated")
  recommendationsGenerated Int      @default(0) @map("recommendations_generated")
  durationMs               Int      @default(0) @map("duration_ms")
  scoringConfigSnapshot    Json     @default("{}") @map("scoring_config_snapshot")
  createdAt                DateTime @default(now()) @map("created_at")

  items AlphaRecommendationItem[]

  @@index([userId, createdAt(sort: Desc)])
  @@map("alpha_recommendation_runs")
}

model AlphaRecommendationItem {
  id                   String   @id @default(cuid())
  runId                String   @map("run_id")
  run                  AlphaRecommendationRun @relation(fields: [runId], references: [id])
  userId               String   @map("user_id")
  symbol               String
  actionType           String   @map("action_type") // "buy" | "sell" | "watch"
  tradeFitScore        Float    @map("trade_fit_score")
  marketConvictionScore Float   @map("market_conviction_score")
  personalEdgeScore    Float    @map("personal_edge_score")
  riskPenaltyScore     Float    @map("risk_penalty_score")
  finalScore           Float    @map("final_score")
  rationaleSummary     String   @map("rationale_summary")
  status               String   @default("generated")
  outcomeStatus        String   @default("pending") @map("outcome_status")
  outcomeReturnPercent Float?   @map("outcome_return_percent")
  sector               String?
  marketCapBucket      String?  @map("market_cap_bucket")
  suggestedStrategy    String   @map("suggested_strategy")
  confidenceLevel      String   @default("medium") @map("confidence_level")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  factors AlphaFactorBreakdown[]

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([runId])
  @@index([symbol])
  @@map("alpha_recommendation_items")
}

model AlphaFactorBreakdown {
  id                   Int    @id @default(autoincrement())
  recommendationItemId String @map("recommendation_item_id")
  item                 AlphaRecommendationItem @relation(fields: [recommendationItemId], references: [id])
  factorKey            String @map("factor_key")
  factorLabel          String @map("factor_label")
  factorCategory       String @map("factor_category") // "market_conviction" | "personal_edge" | "risk_penalty"
  rawValue             Float  @map("raw_value")
  normalizedValue      Float  @map("normalized_value")
  weight               Float
  contributionScore    Float  @map("contribution_score")
  explanation          String

  @@index([recommendationItemId])
  @@map("alpha_factor_breakdowns")
}

model AlphaPatternStats {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id])
  groupType       String   @map("group_type")
  groupValue      String   @map("group_value")
  winRate         Float    @default(0) @map("win_rate")
  avgReturn       Float    @default(0) @map("avg_return")
  medianReturn    Float    @default(0) @map("median_return")
  maxDrawdown     Float    @default(0) @map("max_drawdown")
  bestReturn      Float    @default(0) @map("best_return")
  sampleSize      Int      @default(0) @map("sample_size")
  avgHoldDays     Float    @default(0) @map("avg_hold_days")
  totalPnl        Float    @default(0) @map("total_pnl")
  profitFactor    Float    @default(0) @map("profit_factor")
  recentTrend     String   @default("stable") @map("recent_trend")
  confidenceScore Float    @default(0) @map("confidence_score")
  lastUpdated     DateTime @default(now()) @map("last_updated")

  @@unique([userId, groupType, groupValue])
  @@index([userId])
  @@map("alpha_pattern_stats")
}

model AlphaEdgeSnapshot {
  id                       String   @id @default(cuid())
  userId                   String   @map("user_id")
  user                     User     @relation(fields: [userId], references: [id])
  snapshotDate             DateTime @map("snapshot_date")
  overallWinRate           Float    @default(0) @map("overall_win_rate")
  overallAvgReturn         Float    @default(0) @map("overall_avg_return")
  totalTrades              Int      @default(0) @map("total_trades")
  totalClosedTrades        Int      @default(0) @map("total_closed_trades")
  bestSetups               Json     @default("[]") @map("best_setups")
  worstSetups              Json     @default("[]") @map("worst_setups")
  recommendationHitRate    Float    @default(0) @map("recommendation_hit_rate")
  recommendationsAccepted  Int      @default(0) @map("recommendations_accepted")
  recommendationsGenerated Int      @default(0) @map("recommendations_generated")
  behavioralInsights       Json     @default("[]") @map("behavioral_insights")
  createdAt                DateTime @default(now()) @map("created_at")

  @@index([userId, snapshotDate(sort: Desc)])
  @@map("alpha_edge_snapshots")
}

model AlphaWeeklyReport {
  id                    String   @id @default(cuid())
  userId                String   @map("user_id")
  user                  User     @relation(fields: [userId], references: [id])
  weekStartDate         DateTime @map("week_start_date") @db.Date
  weekEndDate           DateTime @map("week_end_date") @db.Date
  tradesOpened          Int      @default(0) @map("trades_opened")
  tradesClosed          Int      @default(0) @map("trades_closed")
  weekPnl               Float    @default(0) @map("week_pnl")
  weekPnlPercent        Float    @default(0) @map("week_pnl_percent")
  winRate               Float    @default(0) @map("win_rate")
  whatWorked             Json     @default("[]") @map("what_worked")
  whatFailed             Json     @default("[]") @map("what_failed")
  missedPatterns         Json     @default("[]") @map("missed_patterns")
  recommendationHitRate Float    @default(0) @map("recommendation_hit_rate")
  suggestedAdjustments  String[] @default([]) @map("suggested_adjustments")
  createdAt             DateTime @default(now()) @map("created_at")

  @@unique([userId, weekStartDate])
  @@index([userId, weekStartDate(sort: Desc)])
  @@map("alpha_weekly_reports")
}
